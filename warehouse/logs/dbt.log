    create  table
      "warehouse"."main"."agg_episode_summary__dbt_tmp"
  
    as (
      -- Per-episode rollups.
--
-- LOWER CONFIDENCE MART: given the reset-per-email finding in
-- WAREHOUSE.md, most "episodes" produced by running inference.py as-is
-- are exactly one email long, so n_steps will mostly read 1 here. This
-- mart is still correct for whatever episode structure actually occurred
-- -- full multi-email episodes if you drive the server directly (or fix
-- run_task's reset-per-email pattern), single-email "episodes" if you ran
-- inference.py unmodified.

select
    episode_id,
    min(env_dt)                    as episode_dt,
    count(*)                       as n_steps,
    sum(shaped_reward)             as total_shaped_reward,
    avg(shaped_reward)             as avg_shaped_reward,
    max(current_streak)            as max_streak,
    bool_or(is_business_critical)  as had_business_critical_email,
    bool_or(is_phishing)           as had_phishing_email,
    max(env_step)                  as final_step
from "warehouse"."main"."int_steps_joined"
group by 1
order by episode_dt, episode_id
    );
  
  
[0m11:12:54.395092 [debug] [Thread-4 (]: On model.email_rl_warehouse.fct_reward_components: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "email_rl_warehouse", "target_name": "dev", "node_id": "model.email_rl_warehouse.fct_reward_components"} */

  
    
    

    create  table
      "warehouse"."main"."fct_reward_components__dbt_tmp"
  
    as (
      -- Unpacks reward_components (a JSON string column) into individual
-- numeric columns via json_extract_string(...)::double.
--
-- EXPECTED, NOT A BUG: streak_bonus / dependency_bonus / coherence_bonus
-- will read near-zero across most rows if the data was generated by
-- inference.py as-is (reset() before every single graded email wipes
-- multi-step state -- see WAREHOUSE.md "Known findings", #1). Note that
-- phishing_bonus / phishing_miss_penalty were also flat-zero for an
-- unrelated reason (a _sample_episode() bug that dropped the phishing
-- email from every episode) -- that one has since been fixed; see
-- WAREHOUSE.md finding #2 for before/after evidence.

select
    episode_id,
    env_step,
    email_id,
    model_name,
    task,
    shaped_reward,
    json_extract_string(reward_components, '$.base_score')::double                  as base_score,
    json_extract_string(reward_components, '$.urgency_multiplier')::double          as urgency_multiplier,
    json_extract_string(reward_components, '$.streak_bonus')::double                as streak_bonus,
    json_extract_string(reward_components, '$.overload_penalty')::double            as overload_penalty,
    json_extract_string(reward_components, '$.response_time_penalty')::double       as response_time_penalty,
    json_extract_string(reward_components, '$.escalation_multiplier_delta')::double as escalation_multiplier_delta,
    json_extract_string(reward_components, '$.phishing_bonus')::double              as phishing_bonus,
    json_extract_string(reward_components, '$.phishing_miss_penalty')::double       as phishing_miss_penalty,
    json_extract_string(reward_components, '$.dependency_bonus')::double            as dependency_bonus,
    json_extract_string(reward_components, '$.coherence_bonus')::double             as coherence_bonus,
    env_dt as dt
from "warehouse"."main"."int_steps_joined"
    );
  
  
